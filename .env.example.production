# Inmolink — production env reference (Sprint 12).
#
# Copy this to /home/inmolink/inmolink/.env.production on the VPS,
# fill in real values, and reference from PM2 ecosystem.config.cjs.
#
# Anything marked REQUIRED must be set; anything OPTIONAL has a sensible
# default and the related feature degrades gracefully when missing.
#
# Generate secrets with:
#   openssl rand -hex 32

# ============================================================================
# Critical — REQUIRED
# ============================================================================
NODE_ENV=production
DATABASE_URL=postgresql://inmolink:CHANGE_ME@localhost:5432/inmolink?schema=public
REDIS_URL=redis://:CHANGE_ME@localhost:6379

# Auth.js v5 — 32+ chars; rotate via dual-key migration only
AUTH_SECRET=CHANGE_ME_64_HEX_CHARS

# AES-256-GCM key for secrets at rest (SMTP, Stripe, import, webhook, TOTP)
# 64 lowercase hex chars (32 raw bytes)
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# Public-facing URLs — three distinct origins. PLAN §2.1.
PUBLIC_BASE_URL=https://inmolink.eu                # public marketplace (apps/public)
APP_BASE_URL=https://app.inmolink.eu               # authenticated dashboard (apps/web)
API_BASE_URL=https://api.inmolink.eu               # Fastify API (apps/api)

# Next.js public envs (inlined at build time for apps/web + apps/public)
NEXT_PUBLIC_API_URL=https://api.inmolink.eu
NEXT_PUBLIC_PUBLIC_URL=https://inmolink.eu
NEXT_PUBLIC_CDN_URL=https://images.inmolink.eu

# Cookie sharing across subdomains — set to the eTLD+1 so the Auth.js
# session cookie issued on `app.inmolink.eu` is also sent to `api.inmolink.eu`.
AUTH_COOKIE_DOMAIN=.inmolink.eu

CORS_ORIGINS=https://inmolink.eu,https://www.inmolink.eu,https://app.inmolink.eu

# ============================================================================
# Storage — REQUIRED in prod (R2)
# ============================================================================
R2_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=inmolink-media
R2_PUBLIC_BASE_URL=https://images.inmolink.eu

# ============================================================================
# Search — REQUIRED
# ============================================================================
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=CHANGE_ME

# ============================================================================
# Stripe — Sprint 7. Optional in dev, REQUIRED for billing in prod
# ============================================================================
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PRICE_PRO_MONTHLY_EUR=price_CHANGE_ME
STRIPE_PRICE_PRO_YEARLY_EUR=price_CHANGE_ME
STRIPE_PRICE_PRO_MONTHLY_GBP=price_CHANGE_ME
STRIPE_PRICE_PRO_YEARLY_GBP=price_CHANGE_ME
STRIPE_TAX_ENABLED=true

# ============================================================================
# Email — Resend transactional fallback (per-agency SMTP overrides this)
# ============================================================================
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM=Inmolink <noreply@inmolink.eu>

# Worker — embedded in marketing tracking links (open / click / unsubscribe).
# Re-uses the three URL envs defined above; worker reads them by name.
WEB_BASE_URL=https://app.inmolink.eu

# ============================================================================
# AI — Anthropic Claude Haiku (icon suggester + translation drafts)
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# ============================================================================
# Anti-abuse — Cloudflare Turnstile (Sprint 4)
# ============================================================================
TURNSTILE_SECRET=CHANGE_ME
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAA_CHANGE_ME

# ============================================================================
# Logging — OPTIONAL
# ============================================================================
LOG_LEVEL=info
LOGTAIL_SOURCE_TOKEN=CHANGE_ME_OR_LEAVE_EMPTY

# ============================================================================
# Rate limit defaults (overridable per route)
# ============================================================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ============================================================================
# Worker concurrency caps (PLAN §11.7)
# ============================================================================
CONCURRENCY_VARIANTS=4
CONCURRENCY_IMPORTS=1
CONCURRENCY_EMAILS=10
CONCURRENCY_WEBHOOKS=5
CONCURRENCY_REINDEX=2
