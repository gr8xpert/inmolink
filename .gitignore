# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# Turbo
.turbo/

# Prisma
*.db
*.db-journal

# Environment & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
!.env.example
!.env.example.public

secrets/
*.pem
*.key
!*.pub.pem

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test coverage
coverage/
.nyc_output/
*.lcov

# Playwright
test-results/
playwright-report/
playwright/.cache/

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
*.swo
*.iml

# Claude Code local config (user-specific imports/plugins)
.claude/

# OS
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# Uploads / temp (anchored to repo root — don't shadow apps/api/src/modules/uploads/)
/tmp/
/temp/
/uploads/
.cache/

# Dev local-fs storage (LocalFsStorage writes here when R2 isn't configured)
apps/*/tmp/

# PM2
.pm2/

# Sentry
.sentryclirc

# Local data dumps (not for git)
dumps/
*.sql
*.dump

# Prisma migrations DO ship with the repo — re-include them after the broad
# `*.sql` exclusion above. Without this, deploys can't run `prisma migrate
# deploy` because the SQL files never reach prod.
!packages/db/prisma/migrations/**/*.sql

# Generated client code
**/generated/
**/.gen/

# Bundler / linter caches
.eslintcache
.biomecache
.parcel-cache/
.swc/

# Storybook (if used later)
storybook-static/

# graphify knowledge-graph artifacts (regenerable from source)
graphify-out/

# Misc
*.tgz
*.tar.gz
