{
  "name": "@inmolink/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/worker.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/worker.js",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@inmolink/ai": "workspace:*",
    "@inmolink/db": "workspace:*",
    "@inmolink/imports": "workspace:*",
    "@inmolink/pdf": "workspace:*",
    "@inmolink/search": "workspace:*",
    "@inmolink/shared": "workspace:*",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
