{
  "name": "@inmolink/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/worker.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/worker.js",
    "reindex": "tsx --env-file=.env scripts/reindex.ts",
    "seed:bulk": "tsx --env-file=.env scripts/seed-bulk.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@inmolink/ai": "workspace:*",
    "@inmolink/auth": "workspace:*",
    "@inmolink/db": "workspace:*",
    "@inmolink/imports": "workspace:*",
    "@inmolink/pdf": "workspace:*",
    "@inmolink/search": "workspace:*",
    "@inmolink/shared": "workspace:*",
    "@inmolink/storage": "workspace:*",
    "@prisma/client": "^6.0.0",
    "bullmq": "^5.76.7",
    "ioredis": "^5.4.1",
    "nodemailer": "^8.0.5",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
