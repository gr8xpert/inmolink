# Inmolink API (Fastify) — Sprint 0 placeholder.

NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Database (Postgres via PgBouncer in production per PLAN §11.2)
DATABASE_URL=postgresql://inmolink:inmolink@localhost:5432/inmolink?schema=public

# Redis (cache + BullMQ + Socket.io adapter + sessions)
REDIS_URL=redis://localhost:6379

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKeyForLocalDevOnly

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Auth.js v5 — generate with: openssl rand -base64 32
AUTH_SECRET=please-replace-with-openssl-rand-base64-32-bytes-min

# AES-256-GCM encryption key (exactly 32 chars). For: SMTP creds, Stripe keys,
# import credentials, webhook secrets, TOTP secrets, encrypted client info.
# Generate with: openssl rand -base64 24 | head -c 32
ENCRYPTION_KEY=replace-me-32-chars-exactly-aaaaa

# Rate limit defaults (per IP, per route can override)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Stripe (Sprint 7) — leave empty for now
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (transactional email, Sprint 4+) — leave empty for now
RESEND_API_KEY=

# Anthropic Claude (icon suggester + translation drafts) — Sprint 2
ANTHROPIC_API_KEY=

# Cloudflare R2 (Sprint 1)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=inmolink-media
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=https://images.inmolink.local

# Sentry (errors + session replay) — Sprint 12
SENTRY_DSN=
