# Inmolink web (agent dashboard) — Sprint 0 placeholder. Filled out properly in later sprints.

NODE_ENV=development

# Public URL of the web app
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Public URL of the marketplace (apps/public)
NEXT_PUBLIC_PUBLIC_URL=http://localhost:3002

# API base URL (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Auth.js v5
AUTH_SECRET=please-replace-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# Database (Prisma reads this; web app uses @inmolink/db package)
DATABASE_URL=postgresql://inmolink:inmolink@localhost:5432/inmolink?schema=public

# Cloudflare R2 image hostnames (CDN URLs)
NEXT_PUBLIC_CDN_URL=https://images.inmolink.local
