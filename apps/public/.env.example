# Inmolink public marketplace — Sprint 0 placeholder.

NODE_ENV=development

# Public marketplace base URL
NEXT_PUBLIC_PUBLIC_URL=http://localhost:3002

# API base URL (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Database (read replica recommended in production per PLAN §11.2)
DATABASE_URL=postgresql://inmolink:inmolink@localhost:5432/inmolink?schema=public

# Meilisearch (for property search)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKeyForLocalDevOnly

# Cloudflare R2 image hostnames (CDN URLs)
NEXT_PUBLIC_CDN_URL=https://images.inmolink.local

# Cloudflare Turnstile (free CAPTCHA — set when domain registered)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
