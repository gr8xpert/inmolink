# Inmolink DB (Prisma) — used by `prisma migrate dev`, `prisma generate`, etc.

# Direct Postgres connection (used by Prisma migrations + introspection).
# Production uses PgBouncer port 6432 with `transaction` pooling for app
# queries; migrations bypass the pooler and hit Postgres directly per
# Prisma's recommendation.
DATABASE_URL=postgresql://inmolink:inmolink@localhost:5432/inmolink?schema=public

# Optional shadow database for `prisma migrate dev`. Auto-managed if omitted.
# SHADOW_DATABASE_URL=
